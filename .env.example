# CStyle storefront — copy to .env (and .env.production for builds). Never commit real values.

# Backend API base URL, including /api
VITE_API_URL=http://localhost:5000/api

# Approximate LKR per USD, used only for the USD price display toggle
VITE_LKR_PER_USD=300

# Optional: bank details shown after a "Bank Transfer" order (use \n for new lines)
VITE_BANK_DETAILS=
